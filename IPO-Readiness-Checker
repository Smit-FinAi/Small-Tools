  // Reg230: ticked = good (condition complete)
  reg230Items.forEach((_,i)=>{ total++; const el=document.getElementById('reg230_'+i); if(el && el.checked) positiveSignals++; });
  // Reg229
  if(hasVal('postIssueCapital')){ total++; if(num('postIssueCapital')<=25) positiveSignals++; }
