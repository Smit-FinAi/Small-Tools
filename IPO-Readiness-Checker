  <tbody>${rows.map(r=>`
    <tr><td class="metric-col">${r.label}</td>
      ${[0,1,2,3].map(y=>`<td><input type="number" id="mi_${r.id}_${y}" oninput="onMainInputChange()"></td>`).join('')}
    </tr>`).join('')}
  </tbody>`;
}
function mv(id,y){ return num(`mi_${id}_${y}`); }

function onMainInputChange(){
  renderEpsPe(); renderRonw(); renderNav(); renderRatios(); renderPeer();
}

/* ---- EPS & P/E ---- */
function renderEpsPe(){
  const t = document.getElementById('epsPeTable');
  const eps = y => { const s = mv('sharesBasic',y); return s>0 ? mv('pat',y)/s : NaN; };
  const epsD = y => { const s = mv('sharesDiluted',y)||mv('sharesBasic',y); return s>0 ? mv('pat',y)/s : NaN; };
  const e0=eps(0), e1=eps(1), e2=eps(2), e3=eps(3);
  const weighted = (isFinite(e0)&&isFinite(e1)&&isFinite(e2)) ? (e0*1+e1*2+e2*3)/6 : NaN;
  const price = num('issuePrice');
  const peLatest = (price && isFinite(e2) && e2>0) ? price/e2 : NaN;
  const peWeighted = (price && isFinite(weighted) && weighted>0) ? price/weighted : NaN;
  t.innerHTML = `<thead><tr><th class="metric-col">Measure</th>${PERIODS.map(p=>`<th>${p}</th>`).join('')}<th>Weighted Avg (3:2:1)</th></tr></thead>
  <tbody>
    <tr><td class="metric-col">Basic EPS (₹)</td>
      <td class="out-cell">${fmt(e0)}</td><td class="out-cell">${fmt(e1)}</td><td class="out-cell">${fmt(e2)}</td><td class="out-cell">${fmt(eps(3))}</td>
      <td class="out-cell">${fmt(weighted)}</td></tr>
    <tr><td class="metric-col">Diluted EPS (₹)</td>
      <td class="out-cell">${fmt(epsD(0))}</td><td class="out-cell">${fmt(epsD(1))}</td><td class="out-cell">${fmt(epsD(2))}</td><td class="out-cell">${fmt(epsD(3))}</td>
      <td class="out-cell">–</td></tr>
    <tr><td class="metric-col">P/E ratio (Issue Price ÷ EPS)</td>
      <td colspan="4" style="text-align:center;" class="field-note">based on latest year (FY3) and weighted-average EPS, shown right →</td>
      <td class="out-cell">Latest: ${fmt(peLatest)}x</td></tr>
    <tr><td class="metric-col">P/E — weighted average EPS basis</td><td colspan="4"></td><td class="out-cell">${fmt(peWeighted)}x</td></tr>
  </tbody>`;
  window.__latestEPS = e2; window.__peLatest = peLatest;
  document.getElementById('peerIssuer').textContent = isFinite(peLatest) ? fmt(peLatest)+'x' : '–';
}

/* ---- RoNW ---- */
function renderRonw(){
  const t = document.getElementById('ronwTable');
  const ronw = y => { const nw = mv('networth',y); return nw!==0 ? (mv('pat',y)/nw*100) : NaN; };
  const r0=ronw(0), r1=ronw(1), r2=ronw(2);
  const weighted = (isFinite(r0)&&isFinite(r1)&&isFinite(r2)) ? (r0*1+r1*2+r2*3)/6 : NaN;
  t.innerHTML = `<thead><tr><th class="metric-col">Measure</th>${PERIODS.map(p=>`<th>${p}</th>`).join('')}<th>Weighted Avg (3:2:1)</th></tr></thead>
  <tbody><tr><td class="metric-col">RoNW = PAT ÷ Net worth (%)</td>
    <td class="out-cell">${fmt(r0)}%</td><td class="out-cell">${fmt(r1)}%</td><td class="out-cell">${fmt(r2)}%</td><td class="out-cell">${fmt(ronw(3))}%</td>
    <td class="out-cell">${fmt(weighted)}%</td></tr></tbody>`;
}

/* ---- NAV ---- */
function renderNav(){
  const t = document.getElementById('navTable');
  const nav = y => { const s = mv('sharesEnd',y); return s>0 ? mv('networth',y)/s : NaN; };
  const price = num('issuePrice');
  const n2 = nav(2);
  const pb = (price && isFinite(n2) && n2>0) ? price/n2 : NaN;
  t.innerHTML = `<thead><tr><th class="metric-col">Measure</th>${PERIODS.map(p=>`<th>${p}</th>`).join('')}</tr></thead>
  <tbody>
    <tr><td class="metric-col">NAV per equity share (₹) = Net worth ÷ Shares o/s</td>
      <td class="out-cell">${fmt(nav(0))}</td><td class="out-cell">${fmt(nav(1))}</td><td class="out-cell">${fmt(n2)}</td><td class="out-cell">${fmt(nav(3))}</td></tr>
    <tr><td class="metric-col">NAV after the issue (at cap price, illustrative)</td>
      <td colspan="4" class="field-note">Price ÷ NAV (P/B, latest year): <b class="out-cell">${fmt(pb)}x</b></td></tr>
  </tbody>`;
}

/* ---- Peer P/E ---- */
let peerRows = [ {name:'', eps:'', pe:''}, {name:'', eps:'', pe:''} ];
function renderPeer(){
  const t = document.getElementById('peerTable');
  t.innerHTML = `<thead><tr><th>Comparable listed peer company</th><th>Peer EPS (₹)</th><th>Peer P/E (x)</th><th></th></tr></thead>
  <tbody>${peerRows.map((r,i)=>`
    <tr>
      <td><input type="text" style="width:200px;" value="${r.name}" oninput="updatePeer(${i},'name',this.value)" placeholder="Company name"></td>
      <td><input type="number" value="${r.eps}" oninput="updatePeer(${i},'eps',this.value)"></td>
      <td><input type="number" value="${r.pe}" oninput="updatePeer(${i},'pe',this.value)"></td>
      <td><button class="remove-peer" onclick="removePeer(${i})">Remove</button></td>
    </tr>`).join('')}
  </tbody>`;
  const pes = peerRows.map(r=>parseFloat(r.pe)).filter(v=>isFinite(v));
  document.getElementById('peerHigh').textContent = pes.length? fmt(Math.max(...pes))+'x':'–';
  document.getElementById('peerLow').textContent = pes.length? fmt(Math.min(...pes))+'x':'–';
  document.getElementById('peerAvg').textContent = pes.length? fmt(pes.reduce((a,b)=>a+b,0)/pes.length)+'x':'–';
}
function updatePeer(i,key,val){ peerRows[i][key]=val; if(key!=='name') renderPeer(); }
function addPeerRow(){ peerRows.push({name:'',eps:'',pe:''}); renderPeer(); }
function removePeer(i){ peerRows.splice(i,1); renderPeer(); }

/* ---- Full accounting ratio suite ---- */
function renderRatios(){
  const box = document.getElementById('ratioOutput');
  const groups = [
    {name:'Liquidity ratios', color:'var(--success)', rows:[
      {label:'Current ratio (Current assets ÷ Current liabilities)', fn:y=>mv('curliab',y)? mv('curassets',y)/mv('curliab',y) : NaN, suf:'x'},
      {label:'Quick ratio ((Current assets − Inventory) ÷ Current liabilities)', fn:y=>mv('curliab',y)? (mv('curassets',y)-mv('inventory',y))/mv('curliab',y) : NaN, suf:'x'},
    ]},
    {name:'Solvency ratios', color:'var(--warn)', rows:[
      {label:'Debt-Equity ratio (Total debt ÷ Net worth)', fn:y=>mv('networth',y)? mv('debt',y)/mv('networth',y) : NaN, suf:'x'},
      {label:'Debt to Total Assets (Total debt ÷ Total assets)', fn:y=>mv('totassets',y)? mv('debt',y)/mv('totassets',y) : NaN, suf:'x'},
      {label:'Interest coverage ratio (EBIT ÷ Interest expense)', fn:y=>mv('interest',y)? mv('ebit',y)/mv('interest',y) : NaN, suf:'x'},
    ]},
    {name:'Efficiency (activity) ratios', color:'var(--primary-2)', rows:[
      {label:'Total asset turnover (Revenue ÷ Total assets)', fn:y=>mv('totassets',y)? mv('rev',y)/mv('totassets',y) : NaN, suf:'x'},
      {label:'Fixed asset turnover (Revenue ÷ Net fixed assets)', fn:y=>mv('fixedassets',y)? mv('rev',y)/mv('fixedassets',y) : NaN, suf:'x'},
      {label:'Inventory turnover (COGS ÷ Inventory)', fn:y=>mv('inventory',y)? mv('cogs',y)/mv('inventory',y) : NaN, suf:'x'},
      {label:'Trade receivables turnover (Revenue ÷ Trade receivables)', fn:y=>mv('receivables',y)? mv('rev',y)/mv('receivables',y) : NaN, suf:'x'},
    ]},
    {name:'Profitability ratios', color:'var(--accent)', rows:[
      {label:'EBITDA margin (EBITDA ÷ Revenue)', fn:y=>mv('rev',y)? mv('ebitda',y)/mv('rev',y)*100 : NaN, suf:'%'},
      {label:'Net profit margin (PAT ÷ Revenue)', fn:y=>mv('rev',y)? mv('pat',y)/mv('rev',y)*100 : NaN, suf:'%'},
      {label:'Return on Net Worth / RoE (PAT ÷ Net worth)', fn:y=>mv('networth',y)? mv('pat',y)/mv('networth',y)*100 : NaN, suf:'%'},
      {label:'Return on Capital Employed (EBIT ÷ Capital employed)', fn:y=>mv('capemployed',y)? mv('ebit',y)/mv('capemployed',y)*100 : NaN, suf:'%'},
    ]},
    {name:'Market / Valuation ratios', color:'var(--danger)', rows:[
      {label:'Basic EPS (₹)', fn:y=>{const s=mv('sharesBasic',y); return s?mv('pat',y)/s:NaN;}, suf:''},
      {label:'NAV / Book value per share (₹)', fn:y=>{const s=mv('sharesEnd',y); return s?mv('networth',y)/s:NaN;}, suf:''},
      {label:'P/E ratio (Issue price ÷ EPS)', fn:y=>{const s=mv('sharesBasic',y); const e=s?mv('pat',y)/s:NaN; const p=num('issuePrice'); return (p&&e)?p/e:NaN;}, suf:'x'},
      {label:'P/B ratio (Issue price ÷ NAV)', fn:y=>{const s=mv('sharesEnd',y); const n=s?mv('networth',y)/s:NaN; const p=num('issuePrice'); return (p&&n)?p/n:NaN;}, suf:'x'},
      {label:'EV / EBITDA', fn:y=>{const s=mv('sharesEnd',y); const p=num('issuePrice'); const mcap=(p&&s)?p*s:NaN; const ev=isFinite(mcap)?mcap+mv('debt',y)-mv('cash',y):NaN; return mv('ebitda',y)?ev/mv('ebitda',y):NaN;}, suf:'x'},
      {label:'Dividend yield (Dividend per share ÷ Issue price)', fn:y=>{const p=num('issuePrice'); return p? mv2('dps',y)/p*100 : NaN;}, suf:'%'},
    ]},
  ];
  function mv2(id,y){ return num(`mi_${id}_${y}`); }
  box.innerHTML = groups.map(g=>`
    <div class="ratio-group">
      <h3><span class="dot" style="background:${g.color}"></span>${g.name}</h3>
      <div class="table-wrap"><table>
        <thead><tr><th class="metric-col">Ratio</th>${PERIODS.map(p=>`<th>${p}</th>`).join('')}</tr></thead>
        <tbody>${g.rows.map(r=>`<tr><td class="metric-col">${r.label}</td>${[0,1,2,3].map(y=>{
          const v=r.fn(y); return `<td class="out-cell">${isFinite(v)?fmt(v)+r.suf:'–'}</td>`;
        }).join('')}</tr>`).join('')}</tbody>
      </table></div>
    </div>`).join('');
}

